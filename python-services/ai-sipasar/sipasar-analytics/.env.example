# SiPasar Analytics Service — Environment Variables
# Copy this file to .env and fill in the values before running.

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Google APIs (optional — OSM/Nominatim fallback is used if not set) ────────
GOOGLE_PLACES_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# ── Scoring weights (PRD §9.1 — Competitor Analysis) ─────────────────────────
# competition_score = normalize(w1*density + w2*avg_rating + w3*(1/avg_dist))
COMP_W1_DENSITY=0.50
COMP_W2_AVG_RATING=0.30
COMP_W3_INVERSE_DIST=0.20

# ── Scoring weights (PRD §9.3 — Market Potential) ─────────────────────────────
# market_potential = normalize(a1*demand + a2*purchasing_power + a3*(1-comp) + a4*fit)
MKT_A1_DEMAND=0.35
MKT_A2_PURCHASING_POWER=0.25
MKT_A3_COMPETITION=0.25
MKT_A4_CATEGORY_FIT=0.15

# ── HTTP / Retry ──────────────────────────────────────────────────────────────
HTTP_TIMEOUT=10.0
HTTP_MAX_RETRIES=3

# ── CORS (comma-separated origins; use * for dev) ─────────────────────────────
# CORS_ORIGINS=["http://localhost:3000","https://sipasar.example.com"]
